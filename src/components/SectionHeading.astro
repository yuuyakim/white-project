---
type Props = {
  label: string;
  title: string;
};

const { label, title } = Astro.props;
---

<div class="heading">
  <p class="u-label">{label}</p>
  <h2>{title}</h2>
</div>

<style>
  .heading {
    margin-bottom: var(--space-lg);
  }

  h2 {
    font-family: var(--font-display);
    font-weight: 400;
    font-size: clamp(1.35rem, 3vw, 1.75rem);
    letter-spacing: 0.16em;
    margin-top: var(--space-2xs);
  }
</style>
